        function saveStorage() {
            localStorage.setItem('diab_menu_items', JSON.stringify(menuItems));
            localStorage.setItem('diab_menu_categories', JSON.stringify(categories));
        }

        // Render Dynamic Category Tabs
        function renderCategoryTabs() {
            const container = document.getElementById('categoryTabsContainer');
            if (!container) return;
            
            container.innerHTML = `
                <button class="category-tab ${activeCategory === 'all' ? 'active' : ''} whitespace-nowrap px-4 py-1.5 rounded-xl text-xs text-neutral-300 bg-neutral-800 hover:bg-neutral-700 transition" onclick="filterCategory('all', this)">
                    <i class="fa-solid fa-border-all ml-1 text-xs"></i> الكل (${menuItems.length})
                </button>
            `;

            categories.forEach(cat => {
                const count = menuItems.filter(i => i.category === cat.id).length;
                const icon = cat.icon || 'fa-utensils';
                const btn = document.createElement('button');
                btn.className = `category-tab ${activeCategory === cat.id ? 'active' : ''} whitespace-nowrap px-4 py-1.5 rounded-xl text-xs text-neutral-300 bg-neutral-800 hover:bg-neutral-700 transition`;
                btn.onclick = (e) => filterCategory(cat.id, btn);
                btn.innerHTML = `<i class="fa-solid ${icon} ml-1 text-xs"></i> ${cat.name} (${count})`;
                container.appendChild(btn);
            });
        }

        // Render Category Select dropdown in Item Form
        function renderCategoryDropdown() {
            const select = document.getElementById('formCategory');
            if (!select) return;
            select.innerHTML = '';
            categories.forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat.id;
                opt.textContent = cat.name;
                select.appendChild(opt);
            });
        }


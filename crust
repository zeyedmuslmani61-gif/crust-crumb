        // Search Filter
        function filterItems() {
            const query = document.getElementById('searchInput').value.trim().toLowerCase();
            const clearBtn = document.getElementById('clearSearch');
            
            if (query.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
            }

            const filtered = menuItems.filter(item => {
                const matchesCat = (activeCategory === 'all' || item.category === activeCategory);
                const matchesQuery = item.name.toLowerCase().includes(query) || 
                                     item.desc.toLowerCase().includes(query) || 
                                     (item.ingredients && item.ingredients.toLowerCase().includes(query));
                return matchesCat && matchesQuery;
            });

            renderMenu(filtered);
        }

        function clearSearchInput() {
            document.getElementById('searchInput').value = '';
            document.getElementById('clearSearch').classList.add('hidden');
            filterItems();
        }

        function resetSearch() {
            clearSearchInput();
            filterCategory('all', document.querySelectorAll('.category-tab')[0]);
        }

        // Category Filter Tabs
        function filterCategory(catId, element) {
            activeCategory = catId;
            
            document.querySelectorAll('.category-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            if (element) {
                element.classList.add('active');
                element.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }

            filterItems();
        }

        // Admin Modal Controls
        function toggleAdminModal() {
            const modal = document.getElementById('adminModal');
            modal.classList.toggle('hidden');
            if (!modal.classList.contains('hidden')) {
                renderCategoryDropdown();
                if (!document.getElementById('editItemId').value) {
                    resetForm();
                }
            }
        }

        function editItem(id) {
            const item = menuItems.find(i => i.id === id);
            if (!item) return;

            switchAdminSubTab('items');
            document.getElementById('editItemId').value = item.id;
            document.getElementById('formName').value = item.name;
            document.getElementById('formPrice').value = item.price;
            document.getElementById('formCategory').value = item.category;
            document.getElementById('formTag').value = item.tag || '';
            document.getElementById('formImg').value = item.img || '';
            updateImagePreview(item.img);
            document.getElementById('formDesc').value = item.desc || '';
            document.getElementById('formIngredients').value = item.ingredients || '';

            document.getElementById('formSubmitBtn').innerHTML = `<i class="fa-solid fa-pen-to-square"></i> تحديث الصنف`;
            
            const modal = document.getElementById('adminModal');
            modal.classList.remove('hidden');
        }

        function resetForm() {
            document.getElementById('editItemId').value = '';
            document.getElementById('adminForm').reset();
            updateImagePreview('');
            document.getElementById('formSubmitBtn').innerHTML = `<i class="fa-solid fa-plus"></i> إضافة صنف جديد`;
        }

        function saveItemForm(event) {
            event.preventDefault();
            const idVal = document.getElementById('editItemId').value;

            const name = document.getElementById('formName').value.trim();
            const price = document.getElementById('formPrice').value.trim();
            const category = document.getElementById('formCategory').value;
            const tag = document.getElementById('formTag').value.trim();
            const img = document.getElementById('formImg').value.trim() || 'https://images.unsplash.com/photo-1541745537411-b8046dc6d66c?auto=format&fit=crop&w=600&q=80';
            const desc = document.getElementById('formDesc').value.trim();
            const ingredients = document.getElementById('formIngredients').value.trim();

            if (idVal) {
                const index = menuItems.findIndex(i => i.id == idVal);
                if (index !== -1) {
                    menuItems[index] = { ...menuItems[index], name, price, category, tag, img, desc, ingredients };
                }
            } else {
                const newId = menuItems.length > 0 ? Math.max(...menuItems.map(i => i.id)) + 1 : 1;
                menuItems.unshift({ id: newId, name, price, category, tag, img, desc, ingredients });
            }

            saveStorage();
            renderCategoryTabs();
            filterItems();
            resetForm();
            toggleAdminModal();
        }

        function deleteItem(id) {
            menuItems = menuItems.filter(i => i.id !== id);
            saveStorage();
            renderCategoryTabs();
            filterItems();
        }

        function restoreDefaultMenu() {
            categories = [...defaultCategories];
            menuItems = [...defaultMenuItems];
            saveStorage();
            renderCategoryTabs();
            renderCategoryDropdown();
            filterItems();
            toggleAdminModal();
        }

        // Modal Handlers for dish details
        function openModal(itemId) {
            const item = menuItems.find(i => i.id === itemId);
            if (!item) return;

            document.getElementById('modalImg').src = item.img || 'https://images.unsplash.com/photo-1541745537411-b8046dc6d66c?auto=format&fit=crop&w=600&q=80';
            document.getElementById('modalTitle').textContent = item.name;
            document.getElementById('modalPrice').textContent = item.price;
            document.getElementById('modalDesc').textContent = item.desc || '';
            document.getElementById('modalIngredients').textContent = item.ingredients || 'أجبان، زيت، بهارات.';
            
            const badge = document.getElementById('modalBadge');
            if (item.tag) {
                badge.textContent = item.tag;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }

            const modal = document.getElementById('dishModal');
            modal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }

        function closeModal() {
            const modal = document.getElementById('dishModal');
            modal.classList.add('hidden');
            document.body.style.overflow = 'auto';
        }

        function toggleInfoModal() {
            const modal = document.getElementById('infoModal');
            modal.classList.toggle('hidden');
        }

        // Close Modals on Outside Click
        window.onclick = function(event) {
            const dishModal = document.getElementById('dishModal');
            const infoModal = document.getElementById('infoModal');
            const adminModal = document.getElementById('adminModal');
            if (event.target === dishModal) closeModal();
            if (event.target === infoModal) toggleInfoModal();
            if (event.target === adminModal) toggleAdminModal();
        }

        // Initial Load
        document.addEventListener('DOMContentLoaded', () => {
            renderPresetGallery();
            renderCategoryTabs();
            renderCategoryDropdown();
            renderMenu(menuItems);
        });
    </script>
</body>
</html>

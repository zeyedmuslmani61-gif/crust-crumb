        // Category CRUD logic
        function addNewCategory(event) {
            event.preventDefault();
            const nameInput = document.getElementById('newCatName');
            const iconInput = document.getElementById('newCatIcon');

            const name = nameInput.value.trim();
            const icon = iconInput.value.trim() || 'fa-utensils';
            if (!name) return;

            const id = 'cat_' + Date.now();
            categories.push({ id, name, icon });
            
            saveStorage();
            renderCategoryTabs();
            renderCategoryDropdown();
            renderAdminCategoriesList();

            nameInput.value = '';
            iconInput.value = '';
        }

        function editCategoryName(catId) {
            const cat = categories.find(c => c.id === catId);
            if (!cat) return;

            const newName = prompt('أدخل الاسم الجديد للقسم:', cat.name);
            if (newName && newName.trim() !== '') {
                cat.name = newName.trim();
                saveStorage();
                renderCategoryTabs();
                renderCategoryDropdown();
                renderAdminCategoriesList();
                filterItems();
            }
        }

        function deleteCategory(catId) {
            if (categories.length <= 1) {
                alert('لا يمكنك حذف جميع الأقسام. ينبغي البقاء على قسم واحد على الأقل.');
                return;
            }

            categories = categories.filter(c => c.id !== catId);
            // Re-assign items in deleted category to first available category
            const fallbackId = categories[0].id;
            menuItems.forEach(item => {
                if (item.category === catId) {
                    item.category = fallbackId;
                }
            });

            saveStorage();
            renderCategoryTabs();
            renderCategoryDropdown();
            renderAdminCategoriesList();
            filterItems();
        }

        // Sub-tabs switcher in Admin Modal
        function switchAdminSubTab(tab) {
            const itemsTab = document.getElementById('adminItemsSubTab');
            const catsTab = document.getElementById('adminCatsSubTab');
            const itemsBtn = document.getElementById('adminTabItemsBtn');
            const catsBtn = document.getElementById('adminTabCatsBtn');

            if (tab === 'items') {
                itemsTab.classList.remove('hidden');
                catsTab.classList.add('hidden');
                itemsBtn.className = "pb-2 border-b-2 border-brand-500 text-brand-500 font-bold flex items-center gap-1.5";
                catsBtn.className = "pb-2 border-b-2 border-transparent text-neutral-400 hover:text-white font-bold flex items-center gap-1.5";
            } else {
                itemsTab.classList.add('hidden');
                catsTab.classList.remove('hidden');
                catsBtn.className = "pb-2 border-b-2 border-brand-500 text-brand-500 font-bold flex items-center gap-1.5";
                itemsBtn.className = "pb-2 border-b-2 border-transparent text-neutral-400 hover:text-white font-bold flex items-center gap-1.5";
                renderAdminCategoriesList();
            }
        }

        function renderPresetGallery() {
            const container = document.getElementById('presetGallery');
            if (!container) return;
            container.innerHTML = '';
            presetPhotos.forEach(url => {
                const imgBtn = document.createElement('div');
                imgBtn.className = "w-full h-10 rounded-lg overflow-hidden border border-neutral-700 hover:border-brand-500 cursor-pointer transition transform hover:scale-105";
                imgBtn.innerHTML = `<img src="${url}" class="w-full h-full object-cover">`;
                imgBtn.onclick = () => {
                    document.getElementById('formImg').value = url;
                    updateImagePreview(url);
                };
                container.appendChild(imgBtn);
            });
        }

        function updateImagePreview(url) {
            const preview = document.getElementById('formImgPreview');
            preview.src = url || 'https://images.unsplash.com/photo-1541745537411-b8046dc6d66c?auto=format&fit=crop&w=600&q=80';
        }

        function handleImageFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const dataUrl = e.target.result;
                document.getElementById('formImg').value = dataUrl;
                updateImagePreview(dataUrl);
            };
            reader.readAsDataURL(file);
        }

        // Render Menu Cards
        function renderMenu(items) {
            const grid = document.getElementById('menuGrid');
            const noResults = document.getElementById('noResults');
            const itemsCount = document.getElementById('itemsCount');
            const sectionTitle = document.getElementById('sectionTitle');
            
            grid.innerHTML = '';
            
            // Update Section Title Header
            if (activeCategory === 'all') {
                sectionTitle.textContent = 'جميع الأصناف (All Items)';
            } else {
                const currentCatObj = categories.find(c => c.id === activeCategory);
                sectionTitle.textContent = currentCatObj ? currentCatObj.name : 'قائمة الطعام';
            }

            if (items.length === 0) {
                grid.classList.add('hidden');
                noResults.classList.remove('hidden');
                itemsCount.textContent = '0 أصناف';
                return;
            }

            grid.classList.remove('hidden');
            noResults.classList.add('hidden');
            itemsCount.textContent = `${items.length} أصناف`;

            items.forEach(item => {
                const card = document.createElement('div');
                card.className = "food-card bg-[#1a1a1a] border border-neutral-800/90 rounded-2xl p-3 flex gap-3 items-center relative overflow-hidden shadow-lg hover:border-brand-500/50 transition group";

                card.innerHTML = `
